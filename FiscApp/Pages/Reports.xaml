<?xml version="1.0" encoding="utf-8" ?>
<!--
  Reports and Insights page. Bound to ReportsViewModel, which rebuilds all three chart series
  whenever the shared FinanceDataStore's transactions or categories change (data binding driving
  live updates, per the assignment) — this page itself has no chart-building logic left in it.
-->
<ContentPage
    x:Class="FiscApp.Pages.Reports"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodels="clr-namespace:FiscApp.ViewModels"
    xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.Maui;assembly=LiveChartsCore.SkiaSharpView.Maui"
    x:DataType="viewmodels:ReportsViewModel"
    BackgroundColor="{DynamicResource PageBackgroundColor}"
    Title="Reports">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="24">

            <!--  Month-at-a-glance insights (text, computed in ReportsViewModel.RefreshInsights).  -->
            <Border Style="{StaticResource CardStyle}">
                <VerticalStackLayout Spacing="4">
                    <Label Text="{Binding MonthLabel}"
                           Style="{StaticResource SectionHeaderStyle}" />
                    <Label Text="{Binding IncomeText}" TextColor="{StaticResource SuccessColor}" />
                    <Label Text="{Binding ExpensesText}" TextColor="{StaticResource DangerColor}" />
                    <Label Text="{Binding NetText}" FontAttributes="Bold" />
                    <Label Text="{Binding TopCategoryText}" Style="{StaticResource CaptionStyle}" />
                    <Label Text="{Binding OverBudgetText}" Style="{StaticResource CaptionStyle}" />
                </VerticalStackLayout>
            </Border>

            <Label Text="Spending Trend"
                   Style="{StaticResource SectionHeaderStyle}" />
            <!--  Axis and legend colors are bound (not left at LiveCharts' defaults) so they follow
                  the day/night theme — see ReportsViewModel.RefreshCharts.  -->
            <lvc:CartesianChart Series="{Binding TrendSeries}"
                                 XAxes="{Binding TrendXAxes}"
                                 YAxes="{Binding TrendYAxes}"
                                 HeightRequest="250" />

            <Label Text="Category Breakdown"
                   Style="{StaticResource SectionHeaderStyle}" />
            <lvc:PieChart Series="{Binding CategoryBreakdownSeries}"
                          LegendPosition="Right"
                          LegendTextPaint="{Binding LegendTextPaint}"
                           HeightRequest="250" />

            <BoxView Style="{StaticResource DividerStyle}" />

            <!--  Fix #2: "actual spending" here comes from ReportsViewModel calling
                  FinanceDataStore.GetSpentAmount(category, currentMonth) — the same derived,
                  on-demand calculation BudgetViewModel uses — instead of a stored AmountSpent
                  that could disagree with what Budget/MainPage show for the month.  -->
            <Label Text="Budget vs. Actual Spending"
                   Style="{StaticResource SectionHeaderStyle}" />
            <lvc:CartesianChart Series="{Binding BudgetVsActualSeries}"
                                 XAxes="{Binding BudgetXAxes}"
                                 YAxes="{Binding BudgetYAxes}"
                                 LegendPosition="Top"
                                 LegendTextPaint="{Binding LegendTextPaint}"
                                 HeightRequest="280" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
