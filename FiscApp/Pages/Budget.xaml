<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:FiscApp.Models"
             x:Class="FiscApp.Pages.Budget"
             Title="Budget">
    
    <VerticalStackLayout>
        <Label 
            Text="Budget"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />

        <Entry
            x:Name="CategoryNameEntry"
            Placeholder="Category Name" />

        <Entry
            x:Name="CategoryLimitEntry"
            Placeholder="Monthly Limit"
            Keyboard="Numeric"/>

        <Button
            x:Name="AddCategoryButton"
            Text="Add Category"
            Clicked="OnAddCategoryClicked"/>

        <CollectionView ItemsSource="{Binding Categories}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:BudgetCategory">
                    <SwipeView>
                        <SwipeView.RightItems>
                            <SwipeItems>
                                <SwipeItem Text="Delete"
                                   BackgroundColor="#D64545"
                                   CommandParameter="{Binding .}"
                                   Invoked="OnDeleteCategoryClicked" />
                            </SwipeItems>
                        </SwipeView.RightItems>

                        <Border Padding="14"
                        Margin="0,4"
                        BackgroundColor="White"
                        Stroke="Transparent"
                        StrokeShape="RoundRectangle 12">
                            <VerticalStackLayout Spacing="6">
                                <Label Text="{Binding Name}"
                               FontAttributes="Bold"
                               FontSize="16" />
                                <Label Text="{Binding AmountSpent, StringFormat='Spent: {0:C}'}"
                               FontSize="13" />
                                <Label Text="{Binding MonthlyLimit, StringFormat='Limit: {0:C}'}"
                               FontSize="13"
                               TextColor="Gray" />
                                <ProgressBar Progress="{Binding PercentageUsed}"
                                     ProgressColor="{Binding StatusColor}" />
                            </VerticalStackLayout>
                        </Border>
                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </VerticalStackLayout>
</ContentPage>