<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="FiscApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:FiscApp"
    xmlns:pages="clr-namespace:FiscApp.Pages"
    Title="FiscApp"
    FlyoutBehavior="Flyout">

    <!--
      Each ShellContent below becomes one row in the hamburger flyout menu, and registers a
      navigable route (e.g. Shell.Current.GoToAsync("Budget")). ContentTemplate wraps the page
      type in a DataTemplate so Shell only constructs the page (via the DI container set up in
      MauiProgram.cs) the first time the user actually navigates to it, rather than eagerly
      creating every page at startup.
    -->

    <ShellContent
        Title="Home"
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="MainPage" />

    <ShellContent
        Title="Budget"
        ContentTemplate="{DataTemplate pages:Budget}"
        Route="Budget" />

    <ShellContent
        Title="Reports"
        ContentTemplate="{DataTemplate pages:Reports}"
        Route="Reports" />

</Shell>