<?xml version="1.0" encoding="utf-8" ?>
<!--
  Home page (transaction list). Bound to MainViewModel; code-behind only wires up dialogs.
  Layout: the transactions CollectionView is the only scroller. Everything above the list lives in
  its Header. No ScrollView: it gives a CollectionView unlimited height, which can collapse it on Android.
-->
<ContentPage x:Class="FiscApp.MainPage"
             x:Name="RootPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:FiscApp.Models"
             xmlns:viewmodels="clr-namespace:FiscApp.ViewModels"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:DataType="viewmodels:MainViewModel"
             BackgroundColor="{DynamicResource PageBackgroundColor}"
             Title="Finance Tracker">

    <!--  Transactions list. Swipe left = Edit/Delete; long-press = details menu.
          Row commands reach the ViewModel through RootPage, since each row's context is a Transaction.  -->
    <CollectionView x:Name="TransactionsView"
                    ItemsSource="{Binding Transactions}"
                    Margin="16,0">

        <!--  Header: content above the list. Scrolls with it and shares the page's BindingContext.  -->
        <CollectionView.Header>
            <VerticalStackLayout Padding="0,16" Spacing="20">

                <!--  Goals: horizontal list of goal cards  -->
                <Label Text="Your Goals"
                       Style="{StaticResource SectionHeaderStyle}" />

                <CollectionView x:Name="GoalsView"
                                ItemsSource="{Binding Goals}"
                                HeightRequest="150">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Horizontal" ItemSpacing="12" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:FinancialGoal">
                            <Border WidthRequest="180"
                                    Style="{StaticResource CardStyle}">
                                <VerticalStackLayout Spacing="8">
                                    <Label Text="{Binding Name}"
                                           FontAttributes="Bold"
                                           FontSize="15"
                                           TextColor="{DynamicResource PrimaryTextColor}" />
                                    <ProgressBar Progress="{Binding Progress}"
                                                 ProgressColor="{StaticResource AccentColor}" />
                                    <Label Text="{Binding ProgressText}"
                                           FontSize="12"
                                           TextColor="{DynamicResource PrimaryTextColor}" />
                                    <Label Text="{Binding RemainingText}"
                                           FontSize="12"
                                           TextColor="{DynamicResource SecondaryTextColor}" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!--  Divider (dynamic color, dims at night)  -->
                <BoxView Style="{StaticResource DividerStyle}" />

                <Label Text="Transactions"
                       Style="{StaticResource SectionHeaderStyle}" />

                <!--  Hint so users find the hidden gestures  -->
                <Label Text="Tip: swipe a transaction left to edit or delete it, or long-press it for details."
                       Style="{StaticResource CaptionStyle}" />

                <!--  Add/edit form  -->
                <Border Style="{StaticResource CardStyle}">
                    <VerticalStackLayout Spacing="10">
                        <Entry Text="{Binding Description}"
                               Placeholder="What was it for?"
                               TextColor="{DynamicResource PrimaryTextColor}"
                               PlaceholderColor="{DynamicResource SecondaryTextColor}" />

                        <Entry Text="{Binding Notes}"
                               Placeholder="Notes (optional)"
                               TextColor="{DynamicResource PrimaryTextColor}"
                               PlaceholderColor="{DynamicResource SecondaryTextColor}" />

                        <!--  Editable date. DatePicker has no placeholder, so a "Date" label sits beside it.  -->
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalOptions="Center">
                            <Label Grid.Column="0"
                                   Text="Date"
                                   FontSize="14"
                                   VerticalOptions="Center"
                                   TextColor="{DynamicResource SecondaryTextColor}" />
                            <DatePicker Grid.Column="1"
                                        Date="{Binding Date}"
                                        TextColor="{DynamicResource PrimaryTextColor}"
                                        HorizontalOptions="Start" />
                        </Grid>

                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                            <Entry Text="{Binding AmountText}"
                                   Grid.Column="0"
                                   Placeholder="Amount"
                                   Keyboard="Numeric"
                                   TextColor="{DynamicResource PrimaryTextColor}"
                                   PlaceholderColor="{DynamicResource SecondaryTextColor}" />

                            <!--  Type stays null until chosen, so saving without one is blocked  -->
                            <Picker Grid.Column="1"
                                    Title="Type"
                                    TitleColor="{DynamicResource SecondaryTextColor}"
                                    TextColor="{DynamicResource PrimaryTextColor}"
                                    ItemsSource="{Binding TransactionTypes}"
                                    SelectedItem="{Binding SelectedType}" />

                            <!--  Category is required for expenses only, ignored for income  -->
                            <Picker Grid.Column="2"
                                    Title="Category"
                                    TitleColor="{DynamicResource SecondaryTextColor}"
                                    TextColor="{DynamicResource PrimaryTextColor}"
                                    ItemsSource="{Binding Categories}"
                                    ItemDisplayBinding="{Binding Name}"
                                    SelectedItem="{Binding SelectedCategory}" />
                        </Grid>

                        <!--  Same button for add and edit; text changes while editing  -->
                        <Button Text="{Binding SaveButtonText}"
                                Command="{Binding SaveTransactionCommand}"
                                Style="{StaticResource PrimaryButtonStyle}" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </CollectionView.Header>

        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="models:Transaction">
                <SwipeView>
                    <SwipeView.RightItems>
                        <SwipeItems>
                            <SwipeItem Text="Edit"
                                       BackgroundColor="{StaticResource AccentColor}"
                                       Command="{Binding Source={x:Reference RootPage}, Path=BindingContext.EditTransactionCommand}"
                                       CommandParameter="{Binding .}" />
                            <SwipeItem Text="Delete"
                                       BackgroundColor="{StaticResource DangerColor}"
                                       Command="{Binding Source={x:Reference RootPage}, Path=BindingContext.DeleteTransactionCommand}"
                                       CommandParameter="{Binding .}" />
                        </SwipeItems>
                    </SwipeView.RightItems>

                    <Grid Padding="4,10" ColumnDefinitions="*,Auto" BackgroundColor="{DynamicResource CardBackgroundColor}">
                        <Grid.Behaviors>
                            <!--  Long-press (500 ms) opens the details/edit/delete menu  -->
                            <toolkit:TouchBehavior LongPressCommand="{Binding Source={x:Reference RootPage}, Path=BindingContext.LongPressTransactionCommand}"
                                                   LongPressCommandParameter="{Binding .}"
                                                   LongPressDuration="500" />
                        </Grid.Behaviors>
                        <VerticalStackLayout Grid.Column="0">
                            <Label Text="{Binding Description}"
                                   FontSize="15"
                                   TextColor="{DynamicResource PrimaryTextColor}" />
                            <Label Text="{Binding CategoryDisplay}"
                                   FontSize="12"
                                   TextColor="{StaticResource AccentColor}" />
                            <Label Text="{Binding Notes}"
                                   FontSize="12"
                                   TextColor="{DynamicResource SecondaryTextColor}" />
                            <Label Text="{Binding Date, StringFormat='{0:MMM d, yyyy}'}"
                                   FontSize="12"
                                   TextColor="{DynamicResource SecondaryTextColor}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="1"
                               Text="{Binding DisplayAmount}"
                               TextColor="{Binding AmountColor}"
                               FontAttributes="Bold"
                               VerticalOptions="Center" />
                    </Grid>
                </SwipeView>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>

</ContentPage>